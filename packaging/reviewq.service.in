[Unit]
Description=ReviewQ
# No start limit: it counts the user's own starts too, and RestartSec= already spaces restarts.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=:@executable@ serve --managed
Environment=@home@
Environment=@data@
Environment=@config@
Environment=@state@
Environment=@codex@
Environment=@claude@
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
