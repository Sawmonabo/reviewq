#!/usr/bin/env python3
"""Export portable synthetic review sources, native samples, and byte manifests."""

import argparse
import sys
from pathlib import Path

sys.dont_write_bytecode = True

from review_fixture.bundle import sha256, write_new_directory
from review_fixture.export import bundle_files
from review_fixture.presets import PRESETS


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--preset", choices=PRESETS, required=True)
    parser.add_argument("--out", type=Path, required=True, help="new directory with an existing parent")
    args = parser.parse_args()
    try:
        files = bundle_files(args.preset)
        write_new_directory(args.out, files)
    except (OSError, ValueError) as error:
        parser.exit(1, f"{parser.prog}: {error}\n")
    except KeyboardInterrupt:
        parser.exit(130, f"{parser.prog}: interrupted\n")
    print(args.out, sha256(files["manifest.json"]))


if __name__ == "__main__":
    main()
