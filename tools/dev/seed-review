#!/usr/bin/env python3
"""Export the synthetic worked review inputs and their byte manifest."""

import argparse
import hashlib
import json
from pathlib import Path


WORKED = Path(__file__).resolve().parents[2] / "fixtures" / "reviews" / "worked"


def json_bytes(value):
    return (json.dumps(value, sort_keys=True, ensure_ascii=False, indent=2) + "\n").encode("utf-8")


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def worked_files():
    files = {
        name: (WORKED / name).read_bytes()
        for name in ("reviews.json", "sessions.json", "discussions.json", "timeline.json")
    }
    for name, count in (("quiet", 20), ("active", 1200), ("large", 12000)):
        lines = [f"@@ -0,0 +1,{count} @@"]
        lines.extend(f"+export const example{i} = {i};" for i in range(count))
        files[f"{name}.patch"] = "\n".join(lines).encode("utf-8")

    entries = [
        {
            "lead": "active",
            "id": f"active-item-{i}",
            "turn": f"active-turn-{i}",
            "text": f"Update {i} " + "Visible conversation text. " * 10,
            "observed_at": "2026-11-01T00:00:00Z",
        }
        for i in range(100)
    ]
    entries.append(
        {
            "lead": "quiet",
            "id": "quiet-item-0",
            "turn": "quiet-turn-0",
            "text": "Quiet complete",
            "observed_at": "2026-11-01T00:00:00Z",
        }
    )
    files["history.json"] = json_bytes(entries)

    manifest = json_bytes(
        {
            "version": 1,
            "outbox": [],
            "files": {
                name: {"bytes": len(data), "sha256": sha256(data)}
                for name, data in files.items()
            },
        }
    )
    if manifest != (WORKED / "manifest.json").read_bytes():
        raise ValueError("worked source bytes differ from fixtures/reviews/worked/manifest.json")
    files["manifest.json"] = manifest
    return files


def write_new_directory(output, files):
    output.mkdir(mode=0o700)
    created = []
    try:
        for name, data in files.items():
            path = output / name
            with path.open("xb") as stream:
                created.append(path)
                stream.write(data)
    except BaseException:
        for path in created:
            path.unlink(missing_ok=True)
        output.rmdir()
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--preset", choices=["worked"], required=True)
    parser.add_argument("--out", type=Path, required=True, help="new directory with an existing parent")
    args = parser.parse_args()
    try:
        files = worked_files()
        write_new_directory(args.out, files)
    except (OSError, ValueError) as error:
        parser.exit(1, f"{parser.prog}: {error}\n")
    except KeyboardInterrupt:
        parser.exit(130, f"{parser.prog}: interrupted\n")
    print(args.out, sha256(files["manifest.json"]))


if __name__ == "__main__":
    main()
