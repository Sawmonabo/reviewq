{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CheckpointIdDto": {
      "description": "A signed handle for a displayed review checkpoint.",
      "maxUtf8Bytes": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "type": "string"
    },
    "CompactTicket": {
      "properties": {
        "key": {
          "$ref": "#/definitions/TicketKeyDto"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "type": "object"
    },
    "DeliveryReceipt": {
      "description": "The addressed receipt for the message send and receipt lookup routes.",
      "oneOf": [
        {
          "properties": {
            "observedInput": {
              "type": "null"
            },
            "state": {
              "const": "queued",
              "type": "string"
            }
          },
          "required": [
            "state",
            "observedInput"
          ],
          "type": "object"
        },
        {
          "properties": {
            "observedInput": {
              "type": "null"
            },
            "state": {
              "const": "dispatching",
              "type": "string"
            }
          },
          "required": [
            "state",
            "observedInput"
          ],
          "type": "object"
        },
        {
          "properties": {
            "observedInput": {
              "$ref": "#/definitions/ObservedInputDto"
            },
            "state": {
              "const": "started",
              "type": "string"
            }
          },
          "required": [
            "state",
            "observedInput"
          ],
          "type": "object"
        },
        {
          "properties": {
            "observedInput": {
              "type": "null"
            },
            "state": {
              "const": "rejected",
              "type": "string"
            }
          },
          "required": [
            "state",
            "observedInput"
          ],
          "type": "object"
        },
        {
          "properties": {
            "observedInput": {
              "type": "null"
            },
            "state": {
              "const": "uncertain",
              "type": "string"
            }
          },
          "required": [
            "state",
            "observedInput"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "createdAt": {
          "$ref": "#/definitions/UtcTimestampDto"
        },
        "runId": {
          "$ref": "#/definitions/RunIdDto"
        },
        "sessionKey": {
          "$ref": "#/definitions/SessionKeyDto"
        },
        "submissionId": {
          "$ref": "#/definitions/SubmissionIdDto"
        },
        "updatedAt": {
          "$ref": "#/definitions/UtcTimestampDto"
        }
      },
      "required": [
        "submissionId",
        "runId",
        "sessionKey",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "DeliveryReceiptResponse": {
      "description": "The resource and event head from the same authorized snapshot.",
      "properties": {
        "cursor": {
          "$ref": "#/definitions/EventCursorDto"
        },
        "data": {
          "$ref": "#/definitions/DeliveryReceipt"
        }
      },
      "required": [
        "data",
        "cursor"
      ],
      "title": "DeliveryReceiptResponse",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Stable error codes for the public JSON envelope.",
      "enum": [
        "invalid_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "conflict",
        "stale_revision",
        "idempotency_conflict",
        "cursor_expired",
        "precondition_failed",
        "payload_too_large",
        "range_not_satisfiable",
        "busy",
        "unavailable",
        "internal"
      ],
      "type": "string"
    },
    "ErrorDto": {
      "description": "A safe error projection suitable for the requesting client.",
      "properties": {
        "code": {
          "$ref": "#/definitions/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "EventCursorDto": {
      "description": "A durable event cursor serialized as a canonical decimal string.",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0}|9223372036854775807)$",
      "type": "string"
    },
    "EventReplayCursor": {
      "description": "A durable event cursor serialized as a canonical decimal string.",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0}|9223372036854775807)$",
      "title": "EventReplayCursor",
      "type": "string"
    },
    "Failure": {
      "description": "The error envelope for a rejected JSON operation.",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/EventCursorDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "#/definitions/ErrorDto"
        }
      },
      "required": [
        "error",
        "cursor"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FileIdDto": {
      "description": "A file identity at a specified patch revision.",
      "maxUtf8Bytes": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "type": "string"
    },
    "GitShaDto": {
      "description": "A full SHA-1 or SHA-256 Git object name.",
      "pattern": "^([0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})$",
      "type": "string"
    },
    "HistoryAvailability": {
      "enum": [
        "available",
        "partial",
        "unavailable"
      ],
      "type": "string"
    },
    "HistoryContent": {
      "properties": {
        "availability": {
          "$ref": "#/definitions/HistoryAvailability"
        },
        "complete": {
          "type": "boolean"
        },
        "entryId": {
          "$ref": "#/definitions/HistoryEntryIdDto"
        },
        "generation": {
          "$ref": "#/definitions/HistoryGenerationDto"
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/HistoryCursorDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "$ref": "#/definitions/SafeCountDto"
        },
        "reset": {
          "type": "boolean"
        },
        "runId": {
          "$ref": "#/definitions/RunIdDto"
        },
        "sessionKey": {
          "$ref": "#/definitions/SessionKeyDto"
        },
        "text": {
          "$ref": "#/definitions/HistoryText"
        }
      },
      "required": [
        "runId",
        "sessionKey",
        "entryId",
        "generation",
        "availability",
        "offset",
        "text",
        "nextCursor",
        "complete",
        "reset"
      ],
      "type": "object"
    },
    "HistoryContentResponse": {
      "description": "The resource and event head from the same authorized snapshot.",
      "properties": {
        "cursor": {
          "$ref": "#/definitions/EventCursorDto"
        },
        "data": {
          "$ref": "#/definitions/HistoryContent"
        }
      },
      "required": [
        "data",
        "cursor"
      ],
      "title": "HistoryContentResponse",
      "type": "object"
    },
    "HistoryCursorDto": {
      "description": "An opaque continuation for one bounded native history source.",
      "maxUtf8Bytes": 8192,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "type": "string"
    },
    "HistoryEntry": {
      "description": "A visible native entry. Provider timestamps can be unknown.",
      "properties": {
        "contentRef": {
          "$ref": "#/definitions/HistoryCursorDto"
        },
        "entryId": {
          "$ref": "#/definitions/HistoryEntryIdDto"
        },
        "parts": {
          "items": {
            "$ref": "#/definitions/HistoryPart"
          },
          "type": "array"
        },
        "textBytes": {
          "$ref": "#/definitions/SafeCountDto"
        },
        "timestamp": {
          "anyOf": [
            {
              "$ref": "#/definitions/UtcTimestampDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "turnId": {
          "anyOf": [
            {
              "$ref": "#/definitions/HistoryTurnIdDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "entryId",
        "turnId",
        "timestamp",
        "parts"
      ],
      "type": "object"
    },
    "HistoryEntryIdDto": {
      "description": "A visible source entry's provider-native identity.",
      "maxUtf8Bytes": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "type": "string"
    },
    "HistoryGenerationDto": {
      "description": "A generation independent of the global event journal.",
      "maxUtf8Bytes": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "type": "string"
    },
    "HistoryPage": {
      "properties": {
        "availability": {
          "$ref": "#/definitions/HistoryAvailability"
        },
        "generation": {
          "$ref": "#/definitions/HistoryGenerationDto"
        },
        "items": {
          "items": {
            "$ref": "#/definitions/HistoryEntry"
          },
          "maxItems": 100,
          "type": "array"
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/HistoryCursorDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "previousCursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/HistoryCursorDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "reset": {
          "type": "boolean"
        },
        "retryAfterMs": {
          "$ref": "#/definitions/SafeCountDto"
        },
        "runId": {
          "$ref": "#/definitions/RunIdDto"
        },
        "sessionKey": {
          "$ref": "#/definitions/SessionKeyDto"
        }
      },
      "required": [
        "runId",
        "sessionKey",
        "generation",
        "availability",
        "reset",
        "items",
        "nextCursor",
        "previousCursor"
      ],
      "type": "object"
    },
    "HistoryPageResponse": {
      "allOf": [
        {
          "$ref": "#/definitions/Success"
        }
      ],
      "description": "The history HTTP envelope, available as checked JSON bytes.",
      "title": "HistoryPageResponse"
    },
    "HistoryPart": {
      "description": "Ordered visible content for the first Codex reader.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "user_prompt",
              "type": "string"
            },
            "text": {
              "$ref": "#/definitions/HistoryText"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "assistant_text",
              "type": "string"
            },
            "text": {
              "$ref": "#/definitions/HistoryText"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "HistoryText": {
      "description": "Visible text bounded by its exact decoded UTF-8 byte length.",
      "maxUtf8Bytes": 65536,
      "pattern": "^[^\\ud800-\\udfff]*$",
      "type": "string"
    },
    "HistoryTurnIdDto": {
      "description": "A provider-native turn in a scoped source.",
      "maxUtf8Bytes": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "type": "string"
    },
    "HostProviderDto": {
      "enum": [
        "codex",
        "claude"
      ],
      "type": "string"
    },
    "InvalidateEvent": {
      "description": "Bounded resource descriptors for an `invalidate` event.",
      "properties": {
        "resources": {
          "items": {
            "$ref": "#/definitions/ResourceKeyDto"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "resources"
      ],
      "title": "InvalidateEvent",
      "type": "object"
    },
    "MergeRequestIidDto": {
      "description": "A positive merge request IID within its GitLab project.",
      "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0}|9223372036854775807)$",
      "type": "string"
    },
    "MergeRequestRow": {
      "properties": {
        "author": {
          "anyOf": [
            {
              "$ref": "#/definitions/NamedUpstreamId"
            },
            {
              "type": "null"
            }
          ]
        },
        "draft": {
          "type": "boolean"
        },
        "hasAgentQuestions": {
          "type": "boolean"
        },
        "iid": {
          "$ref": "#/definitions/MergeRequestIidDto"
        },
        "mrState": {
          "$ref": "#/definitions/MergeRequestStatus"
        },
        "ourComments": {
          "$ref": "#/definitions/SafeCountDto"
        },
        "own": {
          "type": "boolean"
        },
        "personalApproval": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "projectId": {
          "$ref": "#/definitions/ProjectIdDto"
        },
        "projectPath": {
          "type": "string"
        },
        "queueState": {
          "$ref": "#/definitions/QueueStatus"
        },
        "reasonKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "registeredLeadCount": {
          "$ref": "#/definitions/SafeCountDto"
        },
        "reviewId": {
          "$ref": "#/definitions/ReviewIdDto"
        },
        "runStage": {
          "anyOf": [
            {
              "$ref": "#/definitions/RunStage"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceSha": {
          "$ref": "#/definitions/GitShaDto"
        },
        "tickets": {
          "items": {
            "$ref": "#/definitions/CompactTicket"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "unreadReplies": {
          "$ref": "#/definitions/SafeCountDto"
        },
        "updatedAt": {
          "$ref": "#/definitions/UtcTimestampDto"
        }
      },
      "required": [
        "reviewId",
        "projectId",
        "projectPath",
        "iid",
        "title",
        "tickets",
        "author",
        "sourceSha",
        "mrState",
        "queueState",
        "updatedAt",
        "draft",
        "own",
        "ourComments",
        "unreadReplies",
        "personalApproval",
        "registeredLeadCount",
        "runStage",
        "reasonKind",
        "hasAgentQuestions"
      ],
      "type": "object"
    },
    "MergeRequestStatus": {
      "enum": [
        "open",
        "closed",
        "merged"
      ],
      "type": "string"
    },
    "MessageTextDto": {
      "description": "Exact message text bounded in Unicode scalar values.",
      "pattern": "^[^\\ud800-\\udfff]{1,12000}$",
      "type": "string"
    },
    "NamedUpstreamId": {
      "properties": {
        "id": {
          "$ref": "#/definitions/UpstreamIdDto"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "ObservedInputDto": {
      "description": "The native input confirmed for this submission within the addressed run/session.",
      "properties": {
        "entryId": {
          "$ref": "#/definitions/HistoryEntryIdDto"
        },
        "turnId": {
          "$ref": "#/definitions/HistoryTurnIdDto"
        }
      },
      "required": [
        "turnId",
        "entryId"
      ],
      "type": "object"
    },
    "PageCursorDto": {
      "description": "An opaque keyset continuation for list resources.",
      "maxUtf8Bytes": 8192,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$",
      "type": "string"
    },
    "PatchAvailability": {
      "enum": [
        "complete",
        "incomplete",
        "binary",
        "provider_limited",
        "missing"
      ],
      "type": "string"
    },
    "PatchDiscussion": {
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/definitions/PatchDiscussionAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "discussionId": {
          "type": "string"
        },
        "notes": {
          "items": {
            "$ref": "#/definitions/PatchDiscussionNote"
          },
          "type": "array"
        },
        "outdated": {
          "type": "boolean"
        }
      },
      "required": [
        "discussionId",
        "anchor",
        "outdated",
        "notes"
      ],
      "type": "object"
    },
    "PatchDiscussionAnchor": {
      "properties": {
        "newLine": {
          "anyOf": [
            {
              "$ref": "#/definitions/SafeCountDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "newPath": {
          "type": "string"
        },
        "oldLine": {
          "anyOf": [
            {
              "$ref": "#/definitions/SafeCountDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "oldPath": {
          "type": "string"
        }
      },
      "required": [
        "oldPath",
        "newPath",
        "oldLine",
        "newLine"
      ],
      "type": "object"
    },
    "PatchDiscussionNote": {
      "properties": {
        "author": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "createdAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/UtcTimestampDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "noteId": {
          "type": "string"
        },
        "resolved": {
          "type": "boolean"
        }
      },
      "required": [
        "noteId",
        "author",
        "body",
        "createdAt",
        "resolved"
      ],
      "type": "object"
    },
    "PatchDiscussions": {
      "description": "A bounded compact list with a required nullable keyset continuation.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/definitions/PatchDiscussion"
          },
          "maxItems": 100,
          "type": "array"
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/PageCursorDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewId": {
          "$ref": "#/definitions/ReviewIdDto"
        },
        "revision": {
          "$ref": "#/definitions/PatchRevisionDto"
        }
      },
      "required": [
        "reviewId",
        "revision",
        "items",
        "nextCursor"
      ],
      "type": "object"
    },
    "PatchDiscussionsResponse": {
      "description": "The resource and event head from the same authorized snapshot.",
      "properties": {
        "cursor": {
          "$ref": "#/definitions/EventCursorDto"
        },
        "data": {
          "$ref": "#/definitions/PatchDiscussions"
        }
      },
      "required": [
        "data",
        "cursor"
      ],
      "title": "PatchDiscussionsResponse",
      "type": "object"
    },
    "PatchETagDto": {
      "description": "The strong quoted SHA-256 ETag of a complete patch.",
      "pattern": "^\"[0-9a-f]{64}\"$",
      "type": "string"
    },
    "PatchFile": {
      "description": "One immutable address even when another revision serves identical bytes.",
      "properties": {
        "availability": {
          "$ref": "#/definitions/PatchAvailability"
        },
        "byteLength": {
          "anyOf": [
            {
              "$ref": "#/definitions/SafeCountDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "created": {
          "type": "boolean"
        },
        "deleted": {
          "type": "boolean"
        },
        "fileId": {
          "$ref": "#/definitions/FileIdDto"
        },
        "lineCount": {
          "anyOf": [
            {
              "$ref": "#/definitions/SafeCountDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxLineBytes": {
          "anyOf": [
            {
              "$ref": "#/definitions/SafeCountDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "newPath": {
          "type": "string"
        },
        "oldPath": {
          "type": "string"
        },
        "patchETag": {
          "anyOf": [
            {
              "$ref": "#/definitions/PatchETagDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "renamed": {
          "type": "boolean"
        },
        "reviewId": {
          "$ref": "#/definitions/ReviewIdDto"
