{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AcceptedReference": {
      "additionalProperties": false,
      "properties": {
        "receiptId": {
          "$ref": "#/definitions/ResourceIdDto"
        },
        "sha256": {
          "$ref": "#/definitions/ReportHashDto"
        }
      },
      "required": [
        "receiptId",
        "sha256"
      ],
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "$ref": "#/definitions/FindingConclusion"
        },
        "discussionId": {
          "$ref": "#/definitions/ResourceIdDto"
        },
        "findingIds": {
          "items": {
            "$ref": "#/definitions/ResourceIdDto"
          },
          "maxItems": 50,
          "type": "array"
        },
        "nextAction": {
          "$ref": "#/definitions/NextAction"
        },
        "reason": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "discussionId",
        "conclusion",
        "reason",
        "findingIds",
        "nextAction"
      ],
      "type": "object"
    },
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/definitions/EvidenceReference"
          },
          "type": "array"
        },
        "findingIds": {
          "items": {
            "$ref": "#/definitions/ResourceIdDto"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/definitions/CorrectionKind"
        },
        "reason": {
          "type": "string"
        },
        "receiptId": {
          "$ref": "#/definitions/ResourceIdDto"
        },
        "sha256": {
          "$ref": "#/definitions/ReportHashDto"
        }
      },
      "required": [
        "receiptId",
        "sha256",
        "kind",
        "reason",
        "findingIds",
        "evidence"
      ],
      "type": "object"
    },
    "CorrectionKind": {
      "enum": [
        "presentation",
        "evidence"
      ],
      "type": "string"
    },
    "EvidenceReference": {
      "anyOf": [
        {
          "$ref": "#/definitions/FindingEvidence"
        },
        {
          "$ref": "#/definitions/SectionEvidence"
        }
      ]
    },
    "FindingBasis": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/definitions/FindingBasisKind"
        },
        "text": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    },
    "FindingBasisKind": {
      "enum": [
        "observed",
        "gap"
      ],
      "type": "string"
    },
    "FindingConclusion": {
      "enum": [
        "fixed",
        "clarified_withdrawn",
        "superseded",
        "partly_addressed",
        "still_present",
        "unverified"
      ],
      "type": "string"
    },
    "FindingEdit": {
      "additionalProperties": false,
      "properties": {
        "checkedSha": {
          "$ref": "#/definitions/GitShaDto"
        },
        "conclusion": {
          "$ref": "#/definitions/FindingConclusion"
        },
        "discussionIds": {
          "items": {
            "$ref": "#/definitions/ResourceIdDto"
          },
          "type": "array"
        },
        "findingId": {
          "$ref": "#/definitions/ResourceIdDto"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "findingId",
        "conclusion",
        "reason",
        "checkedSha"
      ],
      "type": "object"
    },
    "FindingEvidence": {
      "additionalProperties": false,
      "properties": {
        "findingId": {
          "$ref": "#/definitions/ResourceIdDto"
        },
        "sha256": {
          "$ref": "#/definitions/ReportHashDto"
        }
      },
      "required": [
        "findingId",
        "sha256"
      ],
      "type": "object"
    },
    "FindingLocation": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "format": "uint32",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "GitShaDto": {
      "description": "A full SHA-1 or SHA-256 Git object name.",
      "pattern": "^([0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})$",
      "type": "string"
    },
    "Handoff": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "amendsReport": {
              "anyOf": [
                {
                  "$ref": "#/definitions/AcceptedReference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "assessments": {
              "items": {
                "$ref": "#/definitions/Assessment"
              },
              "maxItems": 10,
              "type": "array"
            },
            "correctsReport": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Correction"
                },
                {
                  "type": "null"
                }
              ]
            },
            "findingChanges": {
              "items": {
                "$ref": "#/definitions/FindingEdit"
              },
              "maxItems": 50,
              "type": "array"
            },
            "outcome": {
              "const": "final",
              "type": "string"
            },
            "report": {
              "additionalProperties": false,
              "properties": {
                "findings": {
                  "items": {
                    "$ref": "#/definitions/StructuredFinding"
                  },
                  "maxItems": 50,
                  "type": "array"
                },
                "scope": {
                  "$ref": "#/definitions/ReportScope"
                },
                "version": {
                  "format": "uint8",
                  "maximum": 1,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "scope",
                "findings"
              ],
              "type": "object"
            },
            "revision": {
              "$ref": "#/definitions/ReportRevision"
            },
            "sectionChanges": {
              "items": {
                "$ref": "#/definitions/SectionEdit"
              },
              "maxItems": 20,
              "type": "array"
            },
            "source": {
              "$ref": "#/definitions/ReportSource"
            },
            "verdict": {
              "$ref": "#/definitions/ReportVerdict"
            }
          },
          "required": [
            "outcome",
            "source",
            "revision",
            "verdict",
            "report"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "accepted": {
              "$ref": "#/definitions/AcceptedReference"
            },
            "assessments": {
              "items": {
                "$ref": "#/definitions/Assessment"
              },
              "maxItems": 10,
              "type": "array"
            },
            "outcome": {
              "const": "unchanged",
              "type": "string"
            },
            "source": {
              "$ref": "#/definitions/ReportSource"
            }
          },
          "required": [
            "outcome",
            "accepted",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assessments": {
              "items": {
                "$ref": "#/definitions/Assessment"
              },
              "maxItems": 10,
              "type": "array"
            },
            "outcome": {
              "const": "needs_input",
              "type": "string"
            },
            "reason": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "NextAction": {
      "enum": [
        "review",
        "waiting_author"
      ],
      "type": "string"
    },
    "ReportHashDto": {
      "description": "SHA-256 of exact report bytes or their declaration.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ReportRevision": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "sha": {
              "$ref": "#/definitions/GitShaDto"
            }
          },
          "required": [
            "sha"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "sha": {
              "type": "null"
            }
          },
          "required": [
            "sha",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ReportScope": {
      "enum": [
        "full_review",
        "selected_threads",
        "amendment"
      ],
      "type": "string"
    },
    "ReportSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "file",
              "type": "string"
            },
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^/",
              "type": "string"
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ReportHashDto"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "response",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ReportVerdict": {
      "enum": [
        "approve",
        "request_changes",
        "blocked",
        "not_specified"
      ],
      "type": "string"
    },
    "ResourceIdDto": {
      "description": "The public ID carried by a resource invalidation, interpreted by its kind.",
      "maxUtf8Bytes": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
      "type": "string"
    },
    "SectionEdit": {
      "additionalProperties": false,
      "properties": {
        "baselineSha256": {
          "$ref": "#/definitions/ReportHashDto"
        },
        "baselineTitle": {
          "type": "string"
        },
        "conclusion": {
          "$ref": "#/definitions/FindingConclusion"
        },
        "discussionIds": {
          "items": {
            "$ref": "#/definitions/ResourceIdDto"
          },
          "type": "array"
        },
        "reason": {
          "type": "string"
        },
        "replacementTitle": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "baselineTitle",
        "baselineSha256",
        "conclusion",
        "reason"
      ],
      "type": "object"
    },
    "SectionEvidence": {
      "additionalProperties": false,
      "properties": {
        "sectionTitle": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/definitions/ReportHashDto"
        }
      },
      "required": [
        "sectionTitle",
        "sha256"
      ],
      "type": "object"
    },
    "StructuredFinding": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "consequence": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "$ref": "#/definitions/FindingBasis"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/FindingLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "maxLength": 384,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "severity",
        "blocking",
        "consequence",
        "evidence"
      ],
      "type": "object"
    }
  },
  "description": "Tool input and the exact JSON file accepted by the native CLI.",
  "properties": {
    "handoff": {
      "$ref": "#/definitions/Handoff"
    }
  },
  "required": [
    "handoff"
  ],
  "title": "ReportHandoffInput",
  "type": "object"
}
