{
  "description": "ReviewQ native Claude Code companion",
  "modules": [
    "./register.jsx"
  ],
  "hooks": {
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${REVIEWQ_CLAUDE_LINKED:-}\" ]; then \"${REVIEWQ_NATIVE_BIN:-$HOME/.local/bin/reviewq}\" internal claude-hook; fi || :",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${REVIEWQ_CLAUDE_LINKED:-}\" ]; then \"${REVIEWQ_NATIVE_BIN:-$HOME/.local/bin/reviewq}\" internal claude-hook; fi || :",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${REVIEWQ_CLAUDE_LINKED:-}\" ]; then \"${REVIEWQ_NATIVE_BIN:-$HOME/.local/bin/reviewq}\" internal claude-hook; fi || :",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${REVIEWQ_CLAUDE_LINKED:-}\" ]; then \"${REVIEWQ_NATIVE_BIN:-$HOME/.local/bin/reviewq}\" internal claude-hook; fi || :",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${REVIEWQ_CLAUDE_LINKED:-}\" ]; then \"${REVIEWQ_NATIVE_BIN:-$HOME/.local/bin/reviewq}\" internal claude-hook; fi || :",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
