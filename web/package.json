{
  "name": "reviewq-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node dev.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tests --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run imports && pnpm run unused && pnpm run format:check",
    "test:browser": "playwright test",
    "imports": "depcruise --config dependency-cruiser.mjs src",
    "unused": "knip --production --include files,exports,types"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.0",
    "dependency-cruiser": "18.8.0",
    "knip": "6.45.1"
  }
}
