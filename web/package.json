{
  "name": "reviewq-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node dev.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tests --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run imports && pnpm run unused && pnpm run format:check",
    "test:browser": "playwright test",
    "imports": "depcruise --config dependency-cruiser.mjs src",
    "unused": "knip --production --include files,exports,types"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-virtual": "3.14.26",
    "hast-util-to-jsx-runtime": "2.3.6",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "json-schema-to-typescript": "16.0.0",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5"
  }
}
